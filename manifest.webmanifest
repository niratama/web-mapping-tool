{
  "name": "GridMap Studio (方眼紙マッピングツール)",
  "short_name": "GridMap",
  "description": "Webブラウザ上で軽快に動作する方眼紙ベースのマップ作成・編集ツール。フリースクロール、外周壁自動生成、ドア・窓スナップ配置、画像/SVGエクスポート対応。",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#1e293b",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": ["utilities", "productivity", "games"]
}
